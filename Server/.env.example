NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://localhost/soma
SOMA_TOKEN_SECRET=replace-with-at-least-32-random-characters
SOMA_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SOMA_APP_ATTEST_VERIFIER_URL=https://attest.example.com/verify
SOMA_APP_ATTEST_VERIFIER_TOKEN=replace-in-secret-manager
SOMA_OBJECT_BUCKET=soma-agent-temporary
SOMA_OBJECT_REGION=example-region-1
# SOMA_OBJECT_ENDPOINT=https://s3-compatible.example.com
SOMA_PROVIDER_BASE_URL=https://provider.example.com/v1
SOMA_PROVIDER_API_KEY=replace-in-secret-manager
SOMA_PROVIDER_MODEL=replace-with-managed-model
# 只有供应商文档或模型目录明确确认直传视频时才设置为 true；默认 false。
SOMA_PROVIDER_SUPPORTS_DIRECT_VIDEO=false
SOMA_FEEDBACK_GMAIL_CLIENT_ID=replace-in-secret-manager
SOMA_FEEDBACK_GMAIL_CLIENT_SECRET=replace-in-secret-manager
SOMA_FEEDBACK_GMAIL_REFRESH_TOKEN=replace-in-secret-manager
# SOMA_APNS_TEAM_ID=APPLE_TEAM_ID
# SOMA_APNS_KEY_ID=APNS_KEY_ID
# SOMA_APNS_PRIVATE_KEY=replace-with-p8-content-in-secret-manager
SOMA_BUNDLE_ID=top.hedon.soma
